
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum PropertyType {
  APARTMENT
  VILLA
  HOUSE
  PLOT
  COMMERCIAL
}

enum ListingType {
  SALE
  RENT
}

enum PropertyStatus {
  PENDING
  APPROVED
  REJECTED
  SOLD
  RENTED
}

enum AuctionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(BUYER)

  properties Property[] @relation("SellerProperties")
  bids       Bid[]
  favorites  Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String
  city        String
  state       String

  propertyType PropertyType
  listingType  ListingType

  totalSqft Float
  bhk       Int
  bathrooms Int

  price                Float?
  rentPerMonth         Float?
  predictedPriceLakhs  Float?

  images String[] @default([])

  status PropertyStatus @default(PENDING)

  sellerId String
seller   User   @relation("SellerProperties", fields: [sellerId], references: [id])

  auction   Auction?
  favorites Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Auction {
  id         String        @id @default(cuid())
  propertyId String        @unique
  property   Property      @relation(fields: [propertyId], references: [id])

  startPrice Float
  currentBid Float?

  startTime DateTime
  endTime   DateTime

  status AuctionStatus @default(UPCOMING)

  bids Bid[]

  createdAt DateTime @default(now())
}

model Bid {
  id        String   @id @default(cuid())
  amount    Float

  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id])

  bidderId String
  bidder   User   @relation(fields: [bidderId], references: [id])

  createdAt DateTime @default(now())
}

model Favorite {
  id         String   @id @default(cuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, propertyId])
}
