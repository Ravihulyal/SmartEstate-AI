generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum PropertyType {
  APARTMENT
  VILLA
  HOUSE
  PLOT
  COMMERCIAL
}

enum ListingType {
  SALE
  RENT
}

enum PropertyStatus {
  PENDING
  APPROVED
  REJECTED
  SOLD
  RENTED
}

enum AuctionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AuctionAdminAction {
  CANCELLED
  ENDED_EARLY
  WINNER_APPROVED
  WINNER_REJECTED
  PAYMENT_CREATED
  PAYMENT_INITIATED
  PAYMENT_RETRY_INITIATED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_EXPIRED
  SALE_CLOSING_CREATED
  SALE_CLOSING_COMPLETED
  SALE_CLOSING_CANCELLED
}

enum AuctionOutcomeStatus {
  NO_BIDS
  PENDING_SELLER_APPROVAL
  ACCEPTED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

enum SaleClosingStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(BUYER)

  properties             Property[]        @relation("SellerProperties")
  bids                   Bid[]
  favorites              Favorite[]
  auctionAdminAuditLogs  AuctionAuditLog[] @relation("AuctionAdminAudit")
  auctionSellerAuditLogs AuctionAuditLog[] @relation("AuctionSellerAudit")
  auctionBuyerAuditLogs  AuctionAuditLog[] @relation("AuctionBuyerAudit")
  paymentsAsBuyer        Payment[]         @relation("PaymentBuyer")
  paymentsAsSeller       Payment[]         @relation("PaymentSeller")
  closingsAsBuyer        SaleClosing[]     @relation("SaleClosingBuyer")
  closingsAsSeller       SaleClosing[]     @relation("SaleClosingSeller")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id          String @id @default(cuid())
  title       String
  description String
  location    String
  city        String
  state       String

  propertyType PropertyType
  listingType  ListingType

  totalSqft Float
  bhk       Int
  bathrooms Int

  price               Float?
  rentPerMonth        Float?
  predictedPriceLakhs Float?

  images String[] @default([])

  status PropertyStatus @default(PENDING)

  sellerId String
  seller   User   @relation("SellerProperties", fields: [sellerId], references: [id])

  auction   Auction?
  favorites Favorite[]
  payments  Payment[]
  closings  SaleClosing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Auction {
  id         String   @id @default(cuid())
  propertyId String   @unique
  property   Property @relation(fields: [propertyId], references: [id])

  startPrice Float
  currentBid Float?

  startTime DateTime
  endTime   DateTime

  status AuctionStatus @default(UPCOMING)

  outcomeStatus        AuctionOutcomeStatus?
  winningBidId         String?               @unique
  winningBid           Bid?                  @relation("AuctionWinningBid", fields: [winningBidId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sellerDecisionAt     DateTime?
  sellerDecisionReason String?

  bids        Bid[]
  auditLogs   AuctionAuditLog[]
  payments    Payment[]
  saleClosing SaleClosing?

  createdAt DateTime @default(now())
}

model Bid {
  id     String @id @default(cuid())
  amount Float

  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id])

  bidderId String
  bidder   User   @relation(fields: [bidderId], references: [id])

  winningForAuction Auction?  @relation("AuctionWinningBid")
  payments          Payment[] @relation("PaymentWinningBid")

  createdAt DateTime @default(now())
}

model AuctionAuditLog {
  id            String             @id @default(cuid())
  auctionId     String
  auction       Auction            @relation(fields: [auctionId], references: [id])
  adminId       String?
  admin         User?              @relation("AuctionAdminAudit", fields: [adminId], references: [id], onDelete: Restrict)
  sellerId      String?
  seller        User?              @relation("AuctionSellerAudit", fields: [sellerId], references: [id], onDelete: Restrict)
  buyerId       String?
  buyer         User?              @relation("AuctionBuyerAudit", fields: [buyerId], references: [id], onDelete: Restrict)
  paymentId     String?
  payment       Payment?           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  saleClosingId String?
  saleClosing   SaleClosing?       @relation(fields: [saleClosingId], references: [id], onDelete: Restrict)
  action        AuctionAdminAction
  reason        String?
  createdAt     DateTime           @default(now())

  @@index([auctionId, createdAt])
  @@index([paymentId])
  @@index([saleClosingId])
}

model Payment {
  id                   String        @id @default(cuid())
  auctionId            String        @unique
  winningBidId         String
  propertyId           String
  buyerId              String
  sellerId             String
  amount               Decimal       @db.Decimal(14, 2)
  currency             String        @default("INR")
  status               PaymentStatus @default(PENDING)
  transactionReference String        @unique
  provider             String        @default("SIMULATED")
  providerReference    String?       @unique
  isSimulated          Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  paidAt               DateTime?
  expiresAt            DateTime?
  failureReason        String?

  auction    Auction  @relation(fields: [auctionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  winningBid Bid      @relation("PaymentWinningBid", fields: [winningBidId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  buyer      User     @relation("PaymentBuyer", fields: [buyerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  seller     User     @relation("PaymentSeller", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  saleClosing SaleClosing?
  auditLogs   AuctionAuditLog[]

  @@index([auctionId, status])
  @@index([propertyId, status])
  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, expiresAt])
}

model SaleClosing {
  id          String            @id @default(cuid())
  auctionId   String            @unique
  propertyId  String
  paymentId   String            @unique
  buyerId     String
  sellerId    String
  status      SaleClosingStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  completedAt DateTime?

  auction  Auction  @relation(fields: [auctionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  buyer    User     @relation("SaleClosingBuyer", fields: [buyerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  seller   User     @relation("SaleClosingSeller", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  auditLogs AuctionAuditLog[]

  @@index([propertyId, status])
  @@index([buyerId, status])
  @@index([sellerId, status])
}

model Favorite {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, propertyId])
}
